# 本地开发环境变量（已被 .gitignore 隔离，请勿提交）
# 生产环境请使用真实强密钥，并通过环境变量注入，不要依赖此文件
SECRET_KEY=change-me-to-a-long-random-secret-in-production

# 数据库连接（优先使用 DATABASE_URL；或拆分 DB_* 形式）
DATABASE_URL=mysql+pymysql://root:tcst2026@localhost/asset
DB_USER=root
DB_PASSWORD=tcst2026
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asset

# Redis 密码（如启用 requirepass）
REDIS_PASSWORD=

# 是否允许公开自助注册（内部资产系统建议设为 false）
ALLOW_PUBLIC_REGISTRATION=true

# 调试 / 监听（生产务必 FLASK_DEBUG=0，并使用 waitress/gunicorn 等 WSGI 部署）
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

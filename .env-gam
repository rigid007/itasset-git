# 复制本文件为 .env 并填入真实值；.env 切勿提交到版本库
# 生成强随机 SECRET_KEY：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# 数据库连接（二选一）：完整 DATABASE_URL，或拆分 DB_* 形式
#DATABASE_URL=mysql+pymysql://root:GamyyBxg5H@172.16.253.119:3306/asset
DB_USER=root
DB_PASSWORD=GamyyBxg5H
DB_HOST=172.16.253.119
DB_PORT=3306
DB_NAME=asset

# Redis 密码（如启用 requirepass）
REDIS_PASSWORD=strong-redis-password

# 是否允许公开自助注册（内部资产系统建议 false）
ALLOW_PUBLIC_REGISTRATION=false

# 调试 / 监听（生产务必 FLASK_DEBUG=0，并使用 WSGI 部署）
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000
